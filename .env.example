# Local development can use embedded PostgreSQL. Production requires DATABASE_URL.
DATABASE_URL=
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional transactional email endpoint; must be a trusted server-side URL.
MAIL_API_URL=
MAIL_API_TOKEN=
MAIL_FROM=
# Live supplier catalog and provider contracts are not yet supplied.
# Live 3DLOOK/payment adapters deliberately fail closed until implemented and verified.
# Public 3DLOOK SAIA Mobile Tailor widget key (free capture path). Client-exposed by design.
NEXT_PUBLIC_3DLOOK_PUBLIC_KEY=
# HMAC key used only to fingerprint 3DLOOK provider person IDs before storage; never sent to 3DLOOK.
SAIA_DRAFT_FINGERPRINT_SECRET=
# Paid single-use AI scan ($5 service fee). Stripe stays unreachable until a private
# 3DLOOK single-use scan-authorization capability exists (see docs/integrations/3DLOOK.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Garment orders use their own Stripe endpoint secret. Development accepts test keys only.
STRIPE_ORDER_WEBHOOK_SECRET=
PAYMENT_PROVIDER=stripe
# Keep false. Enabling live payments requires separate commercial/release authorization.
PAYMENTS_LIVE_ENABLED=false
SCAN_SERVICE_FEE_CENTS=
SAIA_SCAN_AUTHORIZATION_API_KEY=
# Catalog releases (TASK-015). Outside production the first request that needs the
# catalog imports the reference data and publishes v1; set to false to disable.
# Ignored in production: run `npm run catalog:bootstrap` explicitly.
CATALOG_AUTO_BOOTSTRAP=
# Staff MFA is always required in production, regardless of this setting.
STAFF_MFA_REQUIRED=false
# Local catalog media is development-only. Production storage is gated by Q-024.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/media
