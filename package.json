{
  "name": "vessy-tailoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed:suit-customization": "node scripts/build-suit-customization-seed.mjs",
    "seed:lawrencepur": "node scripts/build-lawrencepur-seed.mjs",
    "seed:demo": "node --import tsx scripts/apply-demo-catalog.ts",
    "seed:demo-images": "node --import tsx scripts/build-demo-images.tsx",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "catalog:bootstrap": "node --import tsx scripts/catalog-bootstrap.ts",
    "staff:grant": "node --import tsx scripts/staff-grant.ts",
    "orders:maintain": "node --import tsx scripts/orders-maintenance.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.6",
    "clsx": "2.1.1",
    "dotenv": "18.0.4",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "openai": "7.23.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
